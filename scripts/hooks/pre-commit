#!/usr/bin/env bash
# Pre-commit quality gate: a wired gate that blocks a bad commit beats any
# instruction to "remember to run the checks". It is tracked and shared, not a
# per-clone .git/hooks file, so every contributor gets the same enforcement.
#
# Enable it once per clone (see docs/ENGINEERING.md):
#     git config core.hooksPath scripts/hooks
#
# What it enforces, and why it is split:
#   - House style (no em/en dashes, no emoji, no AI/tool attribution) runs on
#     every commit, because it is instant and applies to docs as much as code.
#   - The cargo gate (fmt, clippy and rustdoc with warnings denied, plus the
#     full test suite) runs only when this commit actually touches Rust or the
#     build manifest, so a docs-only commit stays fast while a code commit
#     cannot land red.
#   - The 0.4 runner and collector regressions run only when their code,
#     fixture, encounter specification, or test files change.
#   - Release packaging, installed engagement, physical input session, SBOM,
#     workflow, and dependency-migration performance contracts run when their
#     drivers, evidence, or tests change.
#
# Deliberately NOT here: coverage, the locked build, and artifact regeneration.
# Those live in scripts/verify.sh (the release/CI gate); they are too slow to
# run on every commit, and coverage is checked there and in CI instead. This
# hook is the fast floor, not the whole gate. Bypass only in a real emergency
# with `git commit --no-verify`, and run scripts/verify.sh before you push.
set -euo pipefail

cd "$(git rev-parse --show-toplevel)"

# House style applies to every file type and is near-instant.
bash scripts/check-style.sh

# Only pay for the cargo checks when code or the build manifest changed. Include
# renames (R) and deletions (D), not only added/modified, so removing or moving a
# Rust file that breaks the build cannot skip the gate. quotePath-off and NUL
# delimiting keep non-ASCII paths readable to grep.
if git -c core.quotePath=false diff --cached --name-only --diff-filter=ACMRD -z \
    | grep -zqE '\.rs$|(^|/)Cargo\.(toml|lock)$|\.wgsl$'; then
  echo "== fmt =="
  cargo fmt --all --check
  echo "== clippy =="
  cargo clippy --workspace --all-targets -- -D warnings
  echo "== GPU post and App presentation =="
  cargo clippy -p numinous-gpu --all-features --all-targets -- -D warnings
  cargo test -p numinous-gpu --all-features --all-targets --locked
  cargo clippy -p numinous-app --all-features --all-targets -- -D warnings
  cargo test -p numinous-app --all-features --all-targets --locked
  echo "== docs =="
  RUSTDOCFLAGS="-D warnings" cargo doc --workspace --no-deps --locked
  RUSTDOCFLAGS="-D warnings" cargo test --workspace --doc --locked
  echo "== test =="
  cargo test --workspace --all-targets --locked
fi

if git -c core.quotePath=false diff --cached --name-only --diff-filter=ACMRD -z \
    | grep -zqE '^scripts/(mcp-play\.py|local-agent-playtest\.py|agent-(hallway|tactile|first-contact)\.py|flagship-goldens\.py|understanding-(source|study|collect)\.py|understanding-(encounters|probes\.fixture)\.json|test-(mcp-play|local-agent-playtest|agent-cohort|understanding-(study|collect))\.py)$|^docs/evidence/goldens/'; then
  if command -v python3 >/dev/null 2>&1; then
    study_python=python3
  elif command -v python >/dev/null 2>&1; then
    study_python=python
  else
    echo "pre-commit: Python 3.11 or newer is required for the 0.4 study gate" >&2
    exit 1
  fi
  echo "== MCP play driver =="
  "$study_python" scripts/test-mcp-play.py
  echo "== local agent playtest contract =="
  "$study_python" scripts/test-local-agent-playtest.py
  echo "== agent cohort contracts =="
  "$study_python" scripts/test-agent-cohort.py
  if git -c core.quotePath=false diff --cached --name-only --diff-filter=ACMRD -z \
      | grep -zqE '^scripts/flagship-goldens\.py$|^docs/evidence/goldens/'; then
    echo "== flagship visual and audio goldens =="
    "$study_python" scripts/flagship-goldens.py
  fi
  echo "== understanding study runner =="
  "$study_python" scripts/test-understanding-study.py
  echo "== understanding study collector =="
  "$study_python" scripts/test-understanding-collect.py
fi

if git -c core.quotePath=false diff --cached --name-only --diff-filter=ACMRD -z \
    | grep -zqE '^(\.github/workflows/(ci|release|release-packages)\.yml|docs/evidence/dependency-migration-[0-9-]+\.json|scripts/(check|verify)\.(ps1|sh)|scripts/hooks/pre-commit|scripts/(package-release|test-package-release|release-engagement-smoke|test-release-engagement-smoke|input-hardware-session|test-input-hardware-session|sensory-platform-set|test-sensory-platform-(proof|set)|release-sbom|test-release-sbom|test-release-workflow|dependency-migration-performance|test-dependency-migration-performance)\.py)$'; then
  if command -v python3 >/dev/null 2>&1; then
    release_python=python3
  elif command -v python >/dev/null 2>&1; then
    release_python=python
  else
    echo "pre-commit: Python 3.11 or newer is required for the release evidence gates" >&2
    exit 1
  fi
  echo "== release packaging =="
  "$release_python" scripts/test-package-release.py
  echo "== release engagement contract =="
  "$release_python" scripts/test-release-engagement-smoke.py
  echo "== physical input session contract =="
  "$release_python" scripts/test-input-hardware-session.py
  echo "== Sensory Lift platform proof contract =="
  "$release_python" scripts/test-sensory-platform-proof.py
  echo "== Sensory Lift physical set contract =="
  "$release_python" scripts/test-sensory-platform-set.py
  echo "== release SBOM contract =="
  "$release_python" scripts/test-release-sbom.py
  echo "== release workflow contract =="
  "$release_python" scripts/test-release-workflow.py
  echo "== dependency migration performance contract =="
  "$release_python" scripts/test-dependency-migration-performance.py
  echo "== dependency migration performance receipt =="
  "$release_python" scripts/dependency-migration-performance.py --verify-receipt docs/evidence/dependency-migration-2026-08-02.json
fi

echo "pre-commit: all checks passed."
